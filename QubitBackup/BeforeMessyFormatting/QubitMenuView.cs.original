using System;
using System.IO;
using System.Reflection;
using UnityEngine;
using UnityEngine.UI;

namespace Qubit
{
    public sealed class QubitMenuView : MonoBehaviour
    {
        private AssetBundle bundle;
        private Transform front;
        private Canvas frontCanvas, backCanvas;
        private Text clock, date, stats, page;
        private float smoothedDelta, nextDisplayUpdate, lastPress = -1;
        private Button touching;
        public bool ShowClock = true, ShowDate = true, ShowFps = true, ShowLatency = true;
        public Func<int?> GetLatency;
        public event Action HomePressed, DisconnectPressed, SearchPressed, NextPressed, PreviousPressed;

        public static QubitMenuView Create(Assembly assembly, string resourceName = "Qubit.Resources.qubitmenu")
        {
            AssetBundle loaded = null;
            GameObject instance = null;
            try
            {
                using (Stream stream = assembly.GetManifestResourceStream(resourceName))
                {
                    if (stream == null) throw new FileNotFoundException("Embedded AssetBundle not found: " + resourceName);
                    using (var memory = new MemoryStream())
                    {
                        stream.CopyTo(memory);
                        loaded = AssetBundle.LoadFromMemory(memory.ToArray());
                    }
                }
                if (loaded == null) throw new InvalidOperationException("Qubit bundle could not load; check Unity version and platform.");
                var prefab = loaded.LoadAsset<GameObject>("QubitMenu");
                if (prefab == null) throw new InvalidOperationException("QubitMenu prefab missing.");
                instance = Instantiate(prefab);
                DontDestroyOnLoad(instance);
                var view = instance.AddComponent<QubitMenuView>();
                view.bundle = loaded;
                view.Initialize();
                return view;
            }
            catch
            {
                if (instance != null) Destroy(instance);
                if (loaded != null) loaded.Unload(false);
                throw;
            }
        }

        private void Initialize()
        {
            front = transform.Find("Front");
            frontCanvas = front.GetComponent<Canvas>();
            backCanvas = transform.Find("Back").GetComponent<Canvas>();
            foreach (Graphic graphic in GetComponentsInChildren<Graphic>(true))
                graphic.material = null;
            clock = front.Find("Clock").GetComponent<Text>();
            date = front.Find("Date").GetComponent<Text>();
            stats = front.Find("Stats").GetComponent<Text>();
            page = front.Find("Page").GetComponent<Text>();
            Bind("Home", () => HomePressed?.Invoke());
            Bind("Disconnect", () => DisconnectPressed?.Invoke());
            Bind("Search", () => SearchPressed?.Invoke());
            Bind("Next", () => NextPressed?.Invoke());
            Bind("Previous", () => PreviousPressed?.Invoke());
            Bind("OuterTab/OuterExit", () => DisconnectPressed?.Invoke());
        }

        private void Bind(string path, Action action)
        {
            front.Find(path).GetComponent<Button>().onClick.AddListener(() => action());
        }

        public void SetRow(int index, string label, Action onPress, bool enabled = false)
        {
            if (index < 0 || index > 5) throw new ArgumentOutOfRangeException(nameof(index));
            var row = front.Find("Row" + index);
            row.Find("Label").GetComponent<Text>().text = label ?? "";
            var button = row.GetComponent<Button>();
            button.onClick.RemoveAllListeners();
            button.interactable = onPress != null;
            button.targetGraphic.raycastTarget = onPress != null;
            if (onPress != null) button.onClick.AddListener(() => onPress());
            button.targetGraphic.color = enabled ? new Color(.16f,.07f,.23f) : Color.black;
        }

        public void SetPage(int value) { page.text = value.ToString(); }

        public bool TouchAt(Vector3 worldPosition)
        {
            if (!isActiveAndEnabled) return false;
            foreach (var button in front.GetComponentsInChildren<Button>())
            {
                if (!button.IsInteractable() || !button.gameObject.activeInHierarchy) continue;
                var rect = (RectTransform)button.transform;
                Vector3 local = rect.InverseTransformPoint(worldPosition);
                if (Mathf.Abs(local.z * rect.lossyScale.z) > .012f || !rect.rect.Contains(new Vector2(local.x,local.y))) continue;
                if (touching == button) return false;
                touching = button;
                if (Time.unscaledTime - lastPress < .25f) return false;
                lastPress = Time.unscaledTime;
                button.onClick.Invoke();
                return true;
            }
            touching = null;
            return false;
        }

        private void OnDisable() { touching = null; }

        private void Update()
        {
            if (front != null && Camera.main != null)
            {
                bool visible = Vector3.Dot(Camera.main.transform.position - front.position, -front.forward) >= 0;
                frontCanvas.enabled = visible;
                backCanvas.enabled = !visible;
            }
            float dt = Time.unscaledDeltaTime;
            smoothedDelta = smoothedDelta <= 0 ? dt : Mathf.Lerp(smoothedDelta, dt, .08f);
            if (front == null || Time.unscaledTime < nextDisplayUpdate) return;
            nextDisplayUpdate = Time.unscaledTime + .25f;
            DateTime now = DateTime.Now;
            clock.gameObject.SetActive(ShowClock);
            date.gameObject.SetActive(ShowDate);
            stats.gameObject.SetActive(ShowFps || ShowLatency);
            clock.text = now.ToString("h:mm tt",System.Globalization.CultureInfo.InvariantCulture);
            date.text = now.ToString("MM/dd/yyyy",System.Globalization.CultureInfo.InvariantCulture);
            string fps = ShowFps ? Mathf.RoundToInt(1 / Mathf.Max(.0001f,smoothedDelta)) + " FPS" : "";
            string latency = ShowLatency ? (GetLatency?.Invoke()?.ToString() ?? "--") + " ms" : "";
            stats.text = fps + (ShowFps && ShowLatency ? "  |  " : "") + latency;
        }

        private void OnDestroy()
        {
            if (bundle != null) bundle.Unload(false);
        }
    }
}
